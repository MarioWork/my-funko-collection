{
  "name": "my-funko-collection-web",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/checkProductionBundle.ts",
    "build:demo": "cross-env VITE_USE_MOCKS=true VITE_DEMO=true yarn build && cp dist/index.html dist/404.html",
    "lint": "eslint . && prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test-e2e": "tsc -p tsconfig.e2e.json && playwright test -c e2e/playwright.config.ts",
    "dev:playwright": "cross-env VITE_PLAYWRIGHT=true yarn dev",
    "dev:big": "cross-env VITE_USE_MOCKS=true VITE_MOCK_EXTRA_FUNKOS=300 yarn dev",
    "dev:mocks": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=admin yarn dev",
    "dev:member": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=member yarn dev",
    "dev:read-only": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=read-only yarn dev",
    "dev:read-only-admin": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=read-only-admin yarn dev",
    "dev:new-user": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=new-user yarn dev",
    "dev:last-admin": "cross-env VITE_USE_MOCKS=true VITE_MOCK_PERSONA=last-admin yarn dev",
    "dev:signed-out": "cross-env VITE_USE_MOCKS=true VITE_MOCK_AUTH_STATE=signedOut yarn dev",
    "dev:setup": "cross-env VITE_USE_MOCKS=true VITE_MOCK_AUTH_STATE=setup yarn dev",
    "format": "prettier --write .",
    "icons": "node scripts/generateIcons.ts",
    "wasm:copy": "node scripts/copyWasm.ts",
    "predev": "yarn wasm:copy",
    "prebuild": "yarn wasm:copy",
    "pretest-e2e": "yarn wasm:copy"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^6.0.0",
    "@simplewebauthn/browser": "^14",
    "@tanstack/react-table": "^9",
    "axios": "^1.7.2",
    "barcode-detector": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.52.1",
    "react-router": "^8.5.0",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^9.39.5",
    "@msw/playwright": "^0.7.0",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5"
  },
  "packageManager": "yarn@4.18.1"
}
