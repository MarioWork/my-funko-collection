{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting — the Vite template's set. erasableSyntaxOnly bans enum/namespace/parameter properties,
       verbatimModuleSyntax requires `import type`, noUncheckedSideEffectImports checks bare imports resolve. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,

    "types": ["vitest/globals"],

    "paths": {
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@api/*": ["./src/common/api/*"],
      "@services/*": ["./src/common/api/services/*"],
      "@application/*": ["./src/application/*"],
      "@app-types/*": ["./src/types/*"],
      "@utils/*": ["./src/common/utils/*"],
      "@pages/*": ["./src/pages/*"],
      "@components/*": ["./src/common/components/*"],
      "@hooks/*": ["./src/common/hookUtils/*"],
      "@mocks/*": ["./src/mocks/*"],
      "@test-utils": ["./src/testUtils.tsx"]
    }
  },
  "include": ["src"]
}
