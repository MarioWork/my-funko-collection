{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  // devPasswordUtils.ts: the one app file a script reads (checkProductionBundle.ts), with no imports of its own.
  "include": ["vite.config.ts", "scripts/**/*.ts", "src/common/utils/devPasswordUtils.ts"]
}
