{
  "name": "my-funko-collection-api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && node --watch --env-file=.env src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postgres:start": "brew services run postgresql@18",
    "postgres:stop": "brew services stop postgresql@18",
    "images:prune": "node --env-file=.env src/cli/pruneImages.ts",
    "auth:reset": "node --env-file=.env src/cli/resetAuth.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11",
    "@fastify/sensible": "^6",
    "@fastify/static": "^10.0.0",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^6",
    "@fastify/type-provider-zod": "^1.0",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "@simplewebauthn/server": "^14",
    "fastify": "^5.12",
    "fastify-plugin": "^6",
    "pg": "^8",
    "pino": "^10",
    "prisma": "^7",
    "sharp": "^0.34.0",
    "write-excel-file": "^4",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26",
    "@types/pg": "^8",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "msw": "^3.0.3",
    "pino-pretty": "^13",
    "prettier": "^3.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72",
    "vite": "^8",
    "vitest": "^5"
  }
}
