{
  "name": "my-funko-collection-api",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts | pino-pretty",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env src/db/seed.ts",
    "images:prune": "node --env-file=.env src/cli/pruneImages.ts",
    "auth:reset": "node --env-file=.env src/cli/resetAuth.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11",
    "@fastify/cors": "^11",
    "@fastify/helmet": "^13",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11",
    "@fastify/sensible": "^6",
    "@fastify/static": "^10.0.0",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^6",
    "@fastify/type-provider-zod": "^1.0",
    "@libsql/client": "^0.18",
    "@simplewebauthn/server": "^14",
    "drizzle-orm": "^0.45",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.12",
    "fastify-plugin": "^6",
    "pino": "^10",
    "sharp": "^0.34.0",
    "write-excel-file": "^4",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "drizzle-kit": "^0.31",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "msw": "^3.0.3",
    "pino-pretty": "^13",
    "prettier": "^3.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72",
    "vite": "^8",
    "vitest": "^5"
  }
}
