NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
DATABASE_URL=postgresql://funko:funko@localhost:5432/funko_dev
# The address the app is opened at; passkeys are tied to its host name (localhost in dev).
APP_ORIGIN=http://localhost:5173
# Proxies in front of the API (1 behind Caddy); 0 when it is reached directly, as in dev.
TRUST_PROXY_HOPS=0
# Browser origins allowed to call the API from elsewhere, comma-separated; empty turns CORS off (same origin).
CORS_ORIGINS=
UPLOADS_DIR=./data/uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_FUNKO=10
IMAGE_LARGE_PX=2000
IMAGE_MEDIUM_PX=1200
IMAGE_SMALL_PX=480
