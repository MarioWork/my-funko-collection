NODE_ENV=test
LOG_LEVEL=silent
PORT=0
# The server the tests run on. Each test file gets its own throwaway copy of the migrated database, named
# funko_test_<random>, from src/testGlobalSetup.ts and src/setupTests.ts; the name in this URL is never used.
DATABASE_URL=postgresql://funko:funko@localhost:5432/funko_test
MAX_IMAGE_BYTES=2097152
MAX_IMAGES_PER_FUNKO=3
